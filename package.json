{
  "name": "dnd5e-automation-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "fetch": "node --experimental-strip-types src/cli.ts fetch",
    "report": "node --experimental-strip-types src/cli.ts report",
    "inventory": "node --experimental-strip-types src/cli.ts inventory",
    "test": "vitest run && node --experimental-strip-types --test test/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "schema": "python3 scripts/build_schema.py",
    "validate": "node --experimental-strip-types src/cli.ts validate",
    "derive": "node --experimental-strip-types src/cli.ts derive --offline --out artifacts"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.0.18"
  },
  "dependencies": {
    "ajv": "8.17.1"
  }
}
